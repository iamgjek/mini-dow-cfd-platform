# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (use the "Session pooler" or direct connection URI — this app holds one
# long-lived connection per process, so transaction-mode pooling on port
# 6543 is not required).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Live quote feed (TF market TCP socket feed). Host/port/market/symbol have
# sane defaults in config.py — only the credentials are required here.
TF_USERNAME=
TF_PASSWORD=
